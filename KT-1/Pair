using System;
using System.Collections.Generic;
using System.Text;

namespace KT_1
{
    internal class Pair<T1 , T2>
    {
        T1 item1;
        T2 item2;
        public Pair(T1 first, T2 second)
        {
            item1 = first;
            item2 = second;
        }
        public override string ToString()
        {
            return $"Первое значение: {item1} | Второе задание: {item2}";
        }
    }
}
